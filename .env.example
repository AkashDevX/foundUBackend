APP_NAME=CruLynk
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Store datetimes in UTC; show all user-facing times in Australian business time.
APP_TIMEZONE=UTC
APP_DISPLAY_TIMEZONE=Australia/Sydney
APP_DISPLAY_LOCALE=en_AU
# MySQL session timezone (keep +00:00 with APP_TIMEZONE=UTC).
DB_TIMEZONE=+00:00

APP_LOCALE=en_AU
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
# Often the same database as the master registry for local dev (see below). Create schemas: database/scripts/create_foundu_mysql_databases.sql
DB_DATABASE=foundu_masterdb
DB_USERNAME=root
DB_PASSWORD=

# -----------------------------------------------------------------------------
# Multi-tenant: master registry (company → tenant DB) — MySQL
# -----------------------------------------------------------------------------
# Overrides optional; when unset, master connection uses DB_* (same host/user as above).
#
# MASTER_DB_DATABASE=foundu_masterdb
# MASTER_DB_HOST=127.0.0.1
# MASTER_DB_PORT=3306
# MASTER_DB_USERNAME=root
# MASTER_DB_PASSWORD=
#
# Tenant DB names (override if different per environment):
# TENANT_BLUEGREEN_DATABASE=bluegreenfacilityservicesdb
# TENANT_CONSTRUCTCONCEPTS_DATABASE=constructconceptsdb
# TENANT_AIDANDABLE_DATABASE=aidandableservicesdb
#
# Optional: separate tenant DB credentials (defaults fall back to DB_*):
# TENANT_DB_HOST=
# TENANT_DB_USERNAME=
# TENANT_DB_PASSWORD=

# API tenant routing: header must match master companies.slug (see MasterCompaniesSeeder)
# TENANT_IDENTIFIER_HEADER=X-Company-Slug
#
# -----------------------------------------------------------------------------
# Mobile API (React Native / Expo)
# -----------------------------------------------------------------------------
# Bootstrap (master DB): GET /api/v1/bootstrap — lists companies { slug, appKey, name }
# Platform API (header X-Platform-Slug: crulynk — master DB, CruLynk platform only):
#   POST /api/v1/request-organization — new organisation access request from mobile app
# Tenant API (header X-Company-Slug + company DB):
#   POST /api/v1/register — creates employee as pending; body must include registration_company_slug
#     and registration_company_app_key equal to bootstrap appKey when companies.app_key is set in master DB
#   POST /api/v1/login — email + password; returns Sanctum Bearer token only if employment_status=active
#   POST /api/v1/forgot-password — body { email }; emails 6-digit OTP if account is active (throttled)
#   POST /api/v1/forgot-password/verify-otp — body { email, otp }; returns reset_token
#   POST /api/v1/forgot-password/reset — body { reset_token, password, password_confirmation }
#   GET /api/v1/me, POST /api/v1/logout — Authorization: Bearer {token}
#   GET /api/v1/time-clock/status — clock state + geofence radius
#   POST /api/v1/time-clock/clock-in|clock-out — body { latitude, longitude, accuracy_meters? }
# TIME_CLOCK_GEOFENCE_RADIUS_METERS=300
# Reference client code: mobile/auth/ and mobile/README.md
#
# Organization admin (browser): APP_URL → sign in → /admin — approve/decline registrations

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# CruLynk platform controller portal (master DB — not tenant org defaults).
CRULYNK_PLATFORM_EMAIL=admin@crulynk.io
CRULYNK_PLATFORM_PASSWORD=CruLynk#Platform2026
# PLATFORM_IDENTIFIER_HEADER=X-Platform-Slug
# PLATFORM_SLUG=crulynk
